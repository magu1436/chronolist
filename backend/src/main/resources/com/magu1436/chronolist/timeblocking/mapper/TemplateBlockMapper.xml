<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.magu1436.chronolist.timeblocking.mapper.TemplateBlockMapper">
    <select id="getAllTemplateBlocks" resultType="com.magu1436.chronolist.timeblocking.entity.TemplateBlock">
        SELECT id, title, width, color
        FROM template_blocks
    </select>

    <select id="getTemplateBlockById" resultType="com.magu1436.chronolist.timeblocking.entity.TemplateBlock">
        SELECT id, title, width, color
        FROM template_blocks
        WHERE id = #{id}
    </select>